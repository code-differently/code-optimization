{
    "name": "code-optimization-demo",
    "version": "1.0.0",
    "description": "A PNPM monorepo for demonstrating performance optimization in three-tier architecture",
    "private": true,
    "scripts": {
        "dev": "./scripts/dev.sh",
        "dev:network": "./scripts/dev-network.sh",
        "deploy": "./scripts/deploy.sh",
        "dev:all": "pnpm --parallel run dev",
        "build": "pnpm --recursive run build",
        "clean": "pnpm --recursive run clean",
        "db:dev": "pnpm --filter db run dev",
        "api:dev": "pnpm --filter api run dev",
        "web:dev": "pnpm --filter web-fe run dev",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "pnpm dlx prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "typescript": "^5.3.0",
        "@eslint/compat": "^1.2.9",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.28.0",
        "@next/eslint-plugin-next": "^15.3.2",
        "@typescript-eslint/eslint-plugin": "^8.33.0",
        "@typescript-eslint/parser": "^8.33.0",
        "eslint": "9.28.0",
        "eslint-config-google": "^0.14.0",
        "eslint-config-prettier": "^8.10.0",
        "eslint-import-resolver-node": "^0.3.9",
        "eslint-import-resolver-typescript": "^4.3.4",
        "eslint-plugin-jsx-a11y": "^6.8.0",
        "eslint-plugin-prettier": "^5.4.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "prettier": "^3.1.1",
        "typescript-eslint": "^8.33.0"
    },
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    }
}